<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
/* ============================================================
   TAJO DIGITAL 3F — COMPLETE STYLESHEET
   ============================================================ */
:root {
  --blue:#00b4ff; --blue-l:#40cbff; --blue-d:#0080cc;
  --red:#ff1a4b; --red-l:#ff5575;
  --green:#10b981; --purple:#8b5cf6; --amber:#f59e0b;
  --grad:linear-gradient(135deg,#00b4ff 0%,#ff1a4b 100%);
  --grad-b:linear-gradient(135deg,#00b4ff 0%,#0056ff 100%);
  --font:'Outfit',sans-serif; --font2:'Space Grotesk',sans-serif;
  --r:16px; --r-sm:10px; --r-lg:24px; --r-xl:36px;
  --trans:all .35s cubic-bezier(.4,0,.2,1);
  --nav-h:72px;
  --shadow:0 8px 32px rgba(0,0,0,.10);
  --shadow-lg:0 24px 64px rgba(0,0,0,.15);
}
[data-theme="light"]{
  --bg:#f4f7fb; --bg2:#eaf1fb; --bg3:#e0eaf8;
  --surface:#fff; --surface2:#f0f4fa;
  --text:#0d1117; --text2:#4a5568; --text3:#7a8499;
  --border:rgba(0,180,255,.14); --border2:rgba(0,0,0,.07);
  --glass:rgba(255,255,255,.78); --glass-b:rgba(255,255,255,.94);
  --nav:rgba(255,255,255,.9);
  --card:#fff; --footer:#0a0f1a; --input:#f0f4fa;
}
[data-theme="dark"]{
  --bg:#080c14; --bg2:#0c1220; --bg3:#101928;
  --surface:#111827; --surface2:#1a2236;
  --text:#f0f6ff; --text2:#a0b3cc; --text3:#607090;
  --border:rgba(0,180,255,.18); --border2:rgba(255,255,255,.06);
  --glass:rgba(17,24,39,.80); --glass-b:rgba(0,180,255,.22);
  --nav:rgba(8,12,20,.94);
  --card:#111827; --footer:#040709; --input:#1a2236;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--bg);color:var(--text);line-height:1.6;transition:background .4s,color .4s;overflow-x:hidden}
a{text-decoration:none;color:inherit}
img{max-width:100%}
ul{list-style:none}
section{padding:100px 0}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--grad);border-radius:99px}
.g-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* --- LOADING --- */
#loading{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:9999;transition:opacity .6s,visibility .6s}
#loading.gone{opacity:0;visibility:hidden;pointer-events:none}
.loader-box{text-align:center}
.loader-brand{font-size:2.2rem;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:10px;animation:pulsate 1.2s ease-in-out infinite}
.loader-tag{font-size:.8rem;color:var(--text3);font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:30px}
.loader-bar{width:220px;height:4px;background:var(--surface2);border-radius:99px;overflow:hidden;margin:0 auto}
.loader-fill{height:100%;background:var(--grad);border-radius:99px;animation:fillbar 1.5s ease-in-out forwards}
@keyframes fillbar{from{width:0}to{width:100%}}
@keyframes pulsate{0%,100%{opacity:1}50%{opacity:.5}}

/* --- NAVBAR --- */
#navbar{position:fixed;top:0;left:0;right:0;height:var(--nav-h);background:var(--nav);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);z-index:1000;transition:var(--trans)}
#navbar.scrolled{box-shadow:0 4px 30px rgba(0,180,255,.10)}
.nav-inner{height:100%;display:flex;align-items:center;justify-content:space-between}
.nav-logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.22rem}
.nav-logo-icon{width:38px;height:38px;background:var(--grad);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.95rem;box-shadow:0 0 18px rgba(0,180,255,.35)}
.nav-logo-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-links{display:flex;align-items:center;gap:2px}
.nav-links a{padding:8px 14px;border-radius:var(--r-sm);font-weight:500;font-size:.9rem;color:var(--text2);transition:var(--trans)}
.nav-links a:hover{color:var(--blue);background:rgba(0,180,255,.07)}
.nav-actions{display:flex;align-items:center;gap:10px}
.btn-nav-wa{display:flex;align-items:center;gap:8px;padding:10px 20px;background:var(--grad);color:#fff;border-radius:50px;font-weight:600;font-size:.88rem;box-shadow:0 4px 20px rgba(0,180,255,.28);transition:var(--trans)}
.btn-nav-wa:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,180,255,.45)}
#theme-toggle{width:42px;height:42px;background:var(--surface2);border:1px solid var(--border);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);font-size:1rem;transition:var(--trans)}
#theme-toggle:hover{background:rgba(0,180,255,.12);color:var(--blue)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none}
.hamburger span{display:block;width:24px;height:2px;background:var(--text);border-radius:99px;transition:var(--trans)}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
#mobile-nav{display:none;position:fixed;top:var(--nav-h);left:0;right:0;background:var(--nav);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:16px 24px 24px;z-index:999;flex-direction:column;gap:4px}
#mobile-nav.open{display:flex}
#mobile-nav a{padding:12px 16px;border-radius:var(--r-sm);font-weight:500;color:var(--text2);transition:var(--trans)}
#mobile-nav a:hover{color:var(--blue);background:rgba(0,180,255,.08)}

/* --- BUTTONS --- */
.btn-primary{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;background:var(--grad);color:#fff;border-radius:50px;font-weight:700;font-size:1rem;box-shadow:0 6px 28px rgba(0,180,255,.30);transition:var(--trans);border:none;cursor:pointer;font-family:var(--font)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 40px rgba(0,180,255,.45)}
.btn-outline{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;background:transparent;color:var(--text);border:2px solid var(--border);border-radius:50px;font-weight:700;font-size:1rem;transition:var(--trans);cursor:pointer;font-family:var(--font)}
.btn-outline:hover{border-color:var(--blue);color:var(--blue);background:rgba(0,180,255,.06);transform:translateY(-3px)}
.btn-white{display:inline-flex;align-items:center;gap:10px;padding:16px 36px;background:#fff;color:#0080cc;border-radius:50px;font-weight:800;font-size:1rem;box-shadow:0 8px 30px rgba(0,0,0,.18);transition:var(--trans)}
.btn-white:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(0,0,0,.28)}

/* --- SECTION HEADER --- */
.section-header{text-align:center;margin-bottom:64px}
.sec-tag{display:inline-flex;align-items:center;gap:8px;padding:6px 18px;background:rgba(0,180,255,.08);border:1px solid rgba(0,180,255,.2);border-radius:50px;font-size:.8rem;font-weight:600;color:var(--blue);margin-bottom:16px}
.sec-title{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;line-height:1.2;margin-bottom:16px}
.sec-sub{font-size:1.05rem;color:var(--text2);max-width:580px;margin:0 auto}

/* ============================================================
   HERO
   ============================================================ */
#inicio{min-height:100vh;padding-top:var(--nav-h);display:flex;align-items:center;background:var(--bg);position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 80% 50%,rgba(0,180,255,.09) 0%,transparent 65%),radial-gradient(ellipse 50% 50% at 20% 80%,rgba(255,26,75,.07) 0%,transparent 60%);pointer-events:none}
.hero-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(0,180,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,180,255,.05) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,#000 40%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,#000 40%,transparent 100%)}
.hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;position:relative;z-index:2;width:100%}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;background:rgba(0,180,255,.10);border:1px solid rgba(0,180,255,.25);border-radius:50px;font-size:.82rem;font-weight:600;color:var(--blue);margin-bottom:24px;animation:fadeInDown .8s ease forwards}
.hero-badge .dot{width:7px;height:7px;background:var(--blue);border-radius:50%;box-shadow:0 0 8px var(--blue);animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hero-title{font-size:clamp(2.2rem,4.5vw,3.7rem);font-weight:900;line-height:1.12;margin-bottom:20px;animation:fadeInUp .9s .1s ease both}
.hero-sub{font-size:1.1rem;color:var(--text2);max-width:520px;margin-bottom:36px;animation:fadeInUp .9s .2s ease both;line-height:1.75}
.hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:48px;animation:fadeInUp .9s .3s ease both}
.hero-stats{display:flex;gap:30px;animation:fadeInUp .9s .4s ease both}
.hero-stat .num{font-size:2rem;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-stat .lbl{font-size:.78rem;color:var(--text3);font-weight:500}
.hero-visual{position:relative;display:flex;align-items:center;justify-content:center;animation:fadeInRight 1s .2s ease both}
.hvc{width:100%;max-width:460px;background:var(--glass);backdrop-filter:blur(20px);border:1px solid var(--glass-b);border-radius:var(--r-lg);padding:28px;box-shadow:0 30px 80px rgba(0,0,0,.12),0 0 60px rgba(0,180,255,.07);position:relative;overflow:hidden}
.hvc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.hvc-hdr{display:flex;align-items:center;gap:10px;margin-bottom:18px}
.hvc-dots{display:flex;gap:6px}
.hvc-dot{width:10px;height:10px;border-radius:50%}
.hvc-dot:nth-child(1){background:#ff5f57}.hvc-dot:nth-child(2){background:#febc2e}.hvc-dot:nth-child(3){background:#28c840}
.hvc-label{font-size:.77rem;color:var(--text3);font-weight:600}
.hvc-svcs{display:flex;flex-direction:column;gap:10px}
.hvc-svc{display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--r-sm);transition:var(--trans)}
.hvc-svc:hover{border-color:var(--blue);transform:translateX(4px)}
.hvc-ico{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
.hvc-name{font-size:.85rem;font-weight:600}
.hvc-sdesc{font-size:.71rem;color:var(--text3)}
.hvc-price{margin-left:auto;font-size:.82rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;flex-shrink:0}
.hvc-foot{margin-top:16px;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(0,180,255,.06);border:1px solid rgba(0,180,255,.2);border-radius:var(--r-sm)}
.hvc-foot-text{font-size:.79rem;font-weight:600;color:var(--blue)}
.hvc-online{display:flex;align-items:center;gap:6px;font-size:.72rem;color:#10b981;font-weight:600}
.hvc-online .dot{width:6px;height:6px;background:#10b981;border-radius:50%;animation:blink 1.2s infinite}
.float-el{position:absolute;background:var(--glass);backdrop-filter:blur(12px);border:1px solid var(--glass-b);border-radius:var(--r);padding:12px 16px;box-shadow:var(--shadow)}
.float-el:nth-child(2){top:28px;right:-14px;animation:floatUD 4s ease-in-out infinite}
.float-el:nth-child(3){bottom:48px;left:-14px;animation:floatUD 4s ease-in-out infinite reverse}
.fval{font-size:1.2rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.flbl{font-size:.7rem;color:var(--text3);font-weight:500}
@keyframes floatUD{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

/* ============================================================
   3F BRAND VALUES
   ============================================================ */
#marca{padding:80px 0;background:var(--bg2)}
.marca-inner{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.marca-text .eyebrow{font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--blue);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.marca-text h2{font-size:clamp(1.8rem,3vw,2.6rem);font-weight:900;line-height:1.2;margin-bottom:20px}
.marca-text p{font-size:1rem;color:var(--text2);line-height:1.78;margin-bottom:16px}
.frase-inst{margin-top:24px;padding:20px 24px;background:rgba(0,180,255,.07);border:1px solid rgba(0,180,255,.18);border-left:4px solid var(--blue);border-radius:var(--r);font-size:.95rem;font-style:italic;color:var(--text2);line-height:1.7}
.frase-inst span{color:var(--blue);font-weight:700;font-style:normal}
.tres-f-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.tres-f-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r-lg);padding:32px 24px;text-align:center;transition:var(--trans);position:relative;overflow:hidden}
.tres-f-card::before{content:'';position:absolute;inset:0;background:var(--grad);opacity:0;transition:opacity .4s}
.tres-f-card:hover::before{opacity:.04}
.tres-f-card:hover{transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,180,255,.12);border-color:rgba(0,180,255,.4)}
.tf-num{font-size:3.5rem;font-weight:900;line-height:1;margin-bottom:10px;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.tf-letter{font-size:1.5rem;font-weight:800;margin-bottom:8px}
.tf-name{font-size:1.05rem;font-weight:700;margin-bottom:8px}
.tf-desc{font-size:.84rem;color:var(--text2)}

/* ============================================================
   SERVICES
   ============================================================ */
#servicos{background:var(--bg)}
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:24px}
.svc-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r-lg);padding:34px 28px;transition:var(--trans);position:relative;overflow:hidden}
.svc-card:hover{transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,180,255,.12);border-color:rgba(0,180,255,.35)}
.svc-badge{position:absolute;top:20px;right:20px;padding:5px 12px;border-radius:50px;font-size:.72rem;font-weight:700;text-transform:uppercase}
.svc-ico{width:58px;height:58px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.55rem;margin-bottom:18px}
.svc-name{font-size:1.18rem;font-weight:700;margin-bottom:8px}
.svc-ideal{font-size:.78rem;color:var(--blue);font-weight:600;margin-bottom:12px;padding:4px 10px;background:rgba(0,180,255,.08);border-radius:50px;display:inline-block}
.svc-desc{font-size:.87rem;color:var(--text2);margin-bottom:18px;line-height:1.65}
.svc-items{display:flex;flex-direction:column;gap:6px;margin-bottom:22px}
.svc-item{display:flex;align-items:center;gap:10px;font-size:.84rem;color:var(--text2)}
.svc-item i{color:var(--blue);font-size:.7rem;flex-shrink:0}
.svc-price{border-top:1px solid var(--border);padding-top:18px;margin-top:auto}
.svc-price-label{font-size:.75rem;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px}
.svc-price-val{font-size:1.6rem;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:14px}
.svc-price-val small{font-size:.9rem;font-weight:600}
.svc-price-val sup{font-size:1rem;font-weight:700}
.svc-cta-link{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;background:var(--grad);color:#fff;border-radius:50px;font-weight:700;font-size:.87rem;transition:var(--trans);box-shadow:0 4px 18px rgba(0,180,255,.25)}
.svc-cta-link:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(0,180,255,.4)}

/* ============================================================
   ENTERTAINMENT PLANS
   ============================================================ */
#entretenimento{background:var(--bg2)}
.plans-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:900px;margin:0 auto}
.plan-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r-lg);padding:36px 28px;text-align:center;transition:var(--trans);position:relative;overflow:hidden}
.plan-card.featured{border-color:var(--blue);background:linear-gradient(145deg,rgba(0,180,255,.06),rgba(255,26,75,.04));transform:scale(1.03)}
.plan-card.featured::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.plan-badge{position:absolute;top:16px;right:16px;background:var(--grad);color:#fff;padding:4px 12px;border-radius:50px;font-size:.72rem;font-weight:700}
.plan-card:hover{transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,180,255,.12)}
.plan-card.featured:hover{transform:scale(1.03) translateY(-6px)}
.plan-icon{font-size:2.5rem;margin-bottom:16px}
.plan-name{font-size:1.2rem;font-weight:800;margin-bottom:6px}
.plan-period{font-size:.85rem;color:var(--text3);margin-bottom:20px;font-weight:500}
.plan-price{font-size:2.6rem;font-weight:900;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:6px}
.plan-price sup{font-size:1.2rem;font-weight:700}
.plan-price span{font-size:1rem}
.plan-sub{font-size:.78rem;color:var(--text3);margin-bottom:24px}
.plan-features{display:flex;flex-direction:column;gap:8px;margin-bottom:28px}
.plan-feature{display:flex;align-items:center;gap:10px;font-size:.85rem;color:var(--text2);padding:6px 0;border-bottom:1px solid var(--border)}
.plan-feature:last-child{border-bottom:none}
.plan-feature i{color:var(--green);font-size:.75rem;flex-shrink:0}
.plan-devices{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.plan-dev{font-size:.75rem;color:var(--text3);background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:4px 8px;display:flex;align-items:center;gap:4px}
.plan-dev i{font-size:.7rem;color:var(--blue)}

/* ============================================================
   DIFERENCIAIS
   ============================================================ */
#diferenciais{background:var(--bg)}
.diffs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px}
.diff-card{display:flex;align-items:flex-start;gap:18px;background:var(--card);border:1px solid var(--border);border-radius:var(--r-lg);padding:28px;transition:var(--trans)}
.diff-card:hover{transform:translateY(-4px);border-color:rgba(0,180,255,.38);box-shadow:0 14px 50px rgba(0,180,255,.10)}
.diff-icon{width:52px;height:52px;background:var(--grad);border-radius:14px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;box-shadow:0 6px 20px rgba(0,180,255,.25);flex-shrink:0}
.diff-title{font-size:1rem;font-weight:700;margin-bottom:7px}
.diff-text{font-size:.86rem;color:var(--text2);line-height:1.65}

/* ============================================================
   PROCESSO
   ============================================================ */
#processo{background:var(--bg2)}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative}
